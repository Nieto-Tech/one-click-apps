{"captainVersion":2,"volumes":{"$$cap_appname-wp-data":{}},"dockerCompose":{"services":{"$$cap_appname-wordpress":{"command":["bash","-lc","set -e\n\n# --- Inline DB provisioning (optional) ---\nif [ -n \"${DB_ROOT_PASS}\" ]; then\n  echo \"Attempting inline DB provisioning on ${DB_HOST}:${DB_PORT} ...\"\n  # Escape single quotes for SQL string literal\n  esc_pw=\"$(printf \"%s\" \"${DB_PASS}\" | sed \"s/'/''/g\")\"\n\n  # Write SQL using printf to avoid YAML/heredoc indentation issues\n  printf \"%s\\n\" \\\n    \"CREATE DATABASE IF NOT EXISTS \\`${DB_NAME}\\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;\" \\\n    \"CREATE USER IF NOT EXISTS '${DB_USER}'@'%' IDENTIFIED BY '${esc_pw}';\" \\\n    \"GRANT ALL PRIVILEGES ON \\`${DB_NAME}\\`.* TO '${DB_USER}'@'%';\" \\\n    \"FLUSH PRIVILEGES;\" > /tmp/provision.sql\n\n  # Use MariaDB client (installed above)\n  mariadb -h \"${DB_HOST}\" -P \"${DB_PORT}\" -u root \"-p${DB_ROOT_PASS}\" < /tmp/provision.sql \\\n    && echo \"Provisioning complete.\" \\\n    || echo \"Provisioning failed or already applied — continuing.\"\nelse\n  echo \"No DB root password provided; skipping provisioning.\"\nfi\n\n# WP writable dirs\nmkdir -p /var/www/html/wp-content/{upgrade,tmp,uploads}\nchown -R www-data:www-data /var/www/html/wp-content\n\nexec docker-entrypoint.sh apache2-foreground\n"],"restart":"always","volumes":["$$cap_appname-wp-data:/var/www/html"],"environment":{"WORDPRESS_DB_HOST":"$$cap_db_host:$$cap_db_port","WORDPRESS_DB_USER":"$$cap_appname","WORDPRESS_DB_PASSWORD":"$$cap_db_password","WORDPRESS_DB_NAME":"$$cap_appname","WORDPRESS_CONFIG_EXTRA":"define('FS_METHOD','direct');\ndefine('WP_MEMORY_LIMIT','$$cap_wp_memory_limit');\ndefine('WP_MAX_MEMORY_LIMIT','$$cap_wp_memory_limit');\ndefine('WP_TEMP_DIR','/var/www/html/wp-content/tmp');\n","DB_HOST":"$$cap_db_host","DB_PORT":"$$cap_db_port","DB_NAME":"$$cap_appname","DB_USER":"$$cap_appname","DB_PASS":"$$cap_db_password","DB_ROOT_PASS":"$$cap_db_root_password"},"dockerfileLines":["FROM wordpress:$$cap_wp_version","RUN apt-get update && apt-get install -y --no-install-recommends unzip zip mariadb-client && rm -rf /var/lib/apt/lists/*","RUN docker-php-ext-install zip || true","RUN mkdir -p /var/www/html/wp-content/tmp && chown -R www-data:www-data /var/www/html/wp-content/tmp","RUN printf \"upload_max_filesize=$$cap_upload_limit\\npost_max_size=$$cap_upload_limit\\nmemory_limit=$$cap_php_memory\\nmax_execution_time=600\\nmax_input_time=600\\n\" > /usr/local/etc/php/conf.d/uploads.ini"]}}},"variables":[{"id":"$$cap_wp_version","label":"WordPress image tag","defaultValue":"latest","description":"From docker.io/library/wordpress tags","validRegex":"/^([^\\s/])+$/"},{"id":"$$cap_db_host","label":"Shared DB host (without port)","defaultValue":"srv-captain--wordpress-db","validRegex":"/^([a-zA-Z0-9_.:-])+$/"},{"id":"$$cap_db_port","label":"Shared DB port","defaultValue":"3306","validRegex":"/^[0-9]+$/"},{"id":"$$cap_db_password","label":"Database user password","defaultValue":"$$cap_gen_random_hex(16)","validRegex":"/.+/"},{"id":"$$cap_db_root_password","label":"(Optional) ROOT password for the shared DB (to auto-create DB/user)","defaultValue":"","description":"Leave blank to skip provisioning. If provided, the container will create DB and user named after the app.","validRegex":"/^.*$/"},{"id":"$$cap_upload_limit","label":"Max upload size (PHP)","defaultValue":"1024M","validRegex":"/^[0-9]+[MG]$/"},{"id":"$$cap_php_memory","label":"PHP memory_limit","defaultValue":"512M","validRegex":"/^[0-9]+[MG]$/"},{"id":"$$cap_wp_memory_limit","label":"WP memory (WP_MEMORY_LIMIT / WP_MAX_MEMORY_LIMIT)","defaultValue":"512M","validRegex":"/^[0-9]+[MG]$/"}],"instructions":{"start":"This deploys WordPress connected to your shared DB. **The application name will be used as both the database name and the database user. Make sure your app name is unique.** To auto-create the DB and user on the shared host, provide the shared DB's ROOT password. If left blank, provisioning is skipped (ensure DB+user exist manually).\n","end":"Map a domain to \"$$cap_appname-wordpress\". In App → HTTP Settings → Custom Nginx Config, set: `client_max_body_size $$cap_upload_limit;` to match PHP's upload limit.\n"},"displayName":"WordPress (Shared DB, High Uploads) — Nieto","isOfficial":true,"description":"Single WordPress container wired to a shared MariaDB host, with larger uploads & memory limits. DB name and user auto-set to the app name. Inline DB/user provision (optional) built in.","documentation":"Connects to your shared MariaDB (srv-captain--wordpress-db:3306 by default). The database name and user are automatically set to your application name. Provide the shared DB ROOT password to auto-create the DB & user inline during startup, or leave blank to skip provisioning.\n"}
